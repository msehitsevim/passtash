<Window x:Class="PassVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PassVault.Views"
        Title="PasStash &#x2014; G&#xFC;venli Parola Sand&#x131;&#x11F;&#x131;"
        Icon="icon.png"
        Width="1160" Height="730" MinWidth="940" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}"
        WindowStyle="None"
        AllowsTransparency="False"
        MouseMove="Window_MouseMove"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- &#x2500;&#x2500;&#x2500; Row 0: Custom Modern Titlebar (WindowChrome) &#x2500;&#x2500;&#x2500; -->
        <Border Grid.Row="0" Background="{DynamicResource BgDeep}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Window Controls (Right side) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Theme Toggle Button -->
                    <Button Style="{StaticResource PVTitlebarIconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="A&#xE7;&#x131;k / Koyu Tema"
                            Margin="0,0,4,0">
                        <TextBlock Text="{Binding IsDarkTheme, Converter={StaticResource ThemeIconConverter}}"
                                   FontSize="14" />
                    </Button>

                    <!-- Lock Button (only in Vault) -->
                    <Button Style="{StaticResource PVTitlebarIconButton}"
                            Command="{Binding LockCommand}"
                            ToolTip="Sand&#x131;&#x11F;&#x131; Kilitle"
                            Visibility="{Binding CurrentView, Converter={StaticResource ViewToVis}, ConverterParameter=Vault}"
                            Margin="0,0,6,0">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextSecondary}" />
                        </Viewbox>
                    </Button>

                    <!-- Minimize -->
                    <Button Style="{StaticResource PVTitlebarButton}"
                            Click="MinimizeButton_Click" ToolTip="Simge Durumuna K&#xFC;&#xE7;&#xFC;lt">
                        <TextBlock Text="&#x2014;" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button x:Name="MaximizeButton" Style="{StaticResource PVTitlebarButton}"
                            Click="MaximizeButton_Click" ToolTip="Ekran&#x131; Kapla">
                        <TextBlock x:Name="MaximizeIcon" Text="&#x25A2;" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                    </Button>

                    <!-- Close -->
                    <Button Style="{StaticResource PVTitlebarCloseButton}"
                            Click="CloseButton_Click" ToolTip="Kapat">
                        <TextBlock Text="&#x2715;" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </StackPanel>

                <!-- Brand and Title (Left side) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="#F59E0B" />
                        </Border.Effect>
                        <Image Source="/PasStash;component/icon.png" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="PasStash" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BgSelected}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="PAROLA SANDI&#x11E;I" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimary}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- &#x2500;&#x2500;&#x2500; Row 1: View Content &#x2500;&#x2500;&#x2500; -->
        <Grid Grid.Row="1">
            <!-- Setup View -->
            <views:SetupView DataContext="{Binding}"
                             Visibility="{Binding CurrentView, Converter={StaticResource ViewToVis}, ConverterParameter=Setup}" />

            <!-- Unlock View -->
            <views:UnlockView DataContext="{Binding}"
                              Visibility="{Binding CurrentView, Converter={StaticResource ViewToVis}, ConverterParameter=Unlock}" />

            <!-- Vault View -->
            <views:VaultView DataContext="{Binding}"
                             Visibility="{Binding CurrentView, Converter={StaticResource ViewToVis}, ConverterParameter=Vault}" />
        </Grid>

        <!-- &#x2500;&#x2500;&#x2500; Row 2: Status Bar &#x2500;&#x2500;&#x2500; -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="16,6"
                Visibility="{Binding CurrentView, Converter={StaticResource ViewToVis}, ConverterParameter=Vault}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center">
                    <Run Text="&#x1F512; AES-256-GCM" />
                    <Run Text=" &#x2022; " />
                    <Run Text="PBKDF2 600K" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>