<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Layers (Deep Obsidian & Charcoal) -->
    <Color x:Key="BgDeepColor">#0A0D14</Color>
    <Color x:Key="BgPrimaryColor">#0F141F</Color>
    <Color x:Key="BgSecondaryColor">#151B2A</Color>
    <Color x:Key="BgTertiaryColor">#1C2438</Color>
    <Color x:Key="BgCardColor">#1A2234</Color>
    <Color x:Key="BgHoverColor">#242E46</Color>
    <Color x:Key="BgSelectedColor">#313E5E</Color>

    <SolidColorBrush x:Key="BgDeep" Color="#0A0D14" />
    <SolidColorBrush x:Key="BgPrimary" Color="#0F141F" />
    <SolidColorBrush x:Key="BgSecondary" Color="#151B2A" />
    <SolidColorBrush x:Key="BgTertiary" Color="#1C2438" />
    <SolidColorBrush x:Key="BgCard" Color="#1A2234" />
    <SolidColorBrush x:Key="BgHover" Color="#242E46" />
    <SolidColorBrush x:Key="BgSelected" Color="#313E5E" />

    <!-- Accent Colors (Glowing Golden Amber) -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentSecondary" Color="#FBBF24" />
    <SolidColorBrush x:Key="AccentDim" Color="#D97706" />
    <SolidColorBrush x:Key="AccentGlow" Color="#FDE68A" />

    <!-- Vibrant Gradient (Golden Amber to Royal Violet) -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Visual Category Badge Gradients -->
    <LinearGradientBrush x:Key="BadgeAllBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeLoginBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#06B6D4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeNoteBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeServerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0" />
        <GradientStop Color="#F43F5E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeStarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#D97706" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BadgeGeneratorBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#14B8A6" Offset="1" />
    </LinearGradientBrush>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
    <SolidColorBrush x:Key="TextAccent" Color="#FBBF24" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#1F293D" />
    <SolidColorBrush x:Key="BorderDefault" Color="#2C3A54" />
    <SolidColorBrush x:Key="BorderAccent" Color="#F59E0B" />

    <!-- Strength Colors -->
    <SolidColorBrush x:Key="StrengthVeryWeak" Color="#EF4444" />
    <SolidColorBrush x:Key="StrengthWeak" Color="#F97316" />
    <SolidColorBrush x:Key="StrengthFair" Color="#EAB308" />
    <SolidColorBrush x:Key="StrengthStrong" Color="#10B981" />
    <SolidColorBrush x:Key="StrengthVeryStrong" Color="#F59E0B" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#334155" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#475569" />
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#F59E0B" />

</ResourceDictionary>