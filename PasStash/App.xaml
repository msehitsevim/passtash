<Application x:Class="PassVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PassVault.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <views:ViewToVisibilityConverter x:Key="ViewToVis" />
            <views:BoolToVisibilityConverter x:Key="BoolToVis" />
            <views:NullToVisibilityConverter x:Key="NullToVis" />
            <views:HexToBrushConverter x:Key="HexToBrush" />
            <views:CategoryToIconConverter x:Key="CatToIcon" />
            <views:CategoryToNameConverter x:Key="CatToName" />
            <views:CategoryToBrushConverter x:Key="CatToBrush" />
            <views:FavoriteToIconConverter x:Key="FavToIcon" />
            <views:PasswordMaskConverter x:Key="PwdMask" />
            <views:ScoreToWidthConverter x:Key="ScoreToWidth" />
            <views:ScoreToRemainingConverter x:Key="ScoreToRemaining" />
            <views:ThemeIconConverter x:Key="ThemeIconConverter" />
            <views:VaultItemSubtitleConverter x:Key="VaultItemSubtitle" />
            <views:SecureNoteVisibilityConverter x:Key="SecureNoteVis" />
            <views:NoteCardVisibilityConverter x:Key="NoteCardVis" />
            <views:NoteBoxHeightConverter x:Key="NoteBoxHeight" />
        </ResourceDictionary>
    </Application.Resources>
</Application>