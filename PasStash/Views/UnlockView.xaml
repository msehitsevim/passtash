<UserControl x:Class="PassVault.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PassVault.Views">
    <Grid Background="{DynamicResource BgDeep}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="410" Padding="36" CornerRadius="18"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.12" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!-- 3D Antique Chest & Key Visual -->
                <Border Width="92" Height="92" CornerRadius="22" Margin="0,0,0,16" HorizontalAlignment="Center"
                        Background="{DynamicResource BgSecondary}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#F59E0B" />
                    </Border.Effect>
                    <Image Source="/PasStash;component/icon.png" Width="92" Height="92"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <TextBlock Text="PasStash" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource BgSelected}" CornerRadius="6" Padding="10,3" Margin="0,6,0,12"
                        HorizontalAlignment="Center">
                    <TextBlock Text="SANDIK K&#x130;L&#x130;TL&#x130;" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimary}" />
                </Border>
                <TextBlock Text="Sand&#x131;&#x11F;&#x131;n&#x131;z&#x131; a&#xE7;mak i&#xE7;in ana parolan&#x131;z&#x131; girin"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           Margin="0,0,0,24" TextAlignment="Center" />

                <!-- Master Password Input -->
                <TextBlock Text="ANA PAROLA" Style="{StaticResource PVLabel}" />
                <PasswordBox x:Name="UnlockPasswordBox" Style="{StaticResource PVPasswordBox}"
                             PasswordChanged="UnlockPasswordBox_PasswordChanged"
                             KeyDown="UnlockPasswordBox_KeyDown" />

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                <!-- Unlock button -->
                <Button Content="Sand&#x131;&#x11F;&#x131; A&#xE7;" Style="{StaticResource PVButtonPrimary}"
                        Command="{Binding UnlockCommand}" Margin="0,22,0,0"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>