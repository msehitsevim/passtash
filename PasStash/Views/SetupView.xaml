<UserControl x:Class="PassVault.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource BgDeep}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="430" Padding="36" CornerRadius="18"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.12" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!-- 3D Antique Chest & Key Visual -->
                <Border Width="92" Height="92" CornerRadius="22" Margin="0,0,0,16" HorizontalAlignment="Center"
                        Background="{DynamicResource BgSecondary}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#F59E0B" />
                    </Border.Effect>
                    <Image Source="/PasStash;component/icon.png" Width="92" Height="92"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <TextBlock Text="PasStash" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource BgSelected}" CornerRadius="6" Padding="10,3" Margin="0,6,0,12"
                        HorizontalAlignment="Center">
                    <TextBlock Text="G&#xDC;VENL&#x130; PAROLA SANDI&#x11E;I" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimary}" />
                </Border>
                <TextBlock Text="De&#x11F;erli parolalar&#x131;n&#x131;z&#x131; korumak i&#xE7;in ana parolan&#x131;z&#x131; belirleyin"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           Margin="0,0,0,24" TextAlignment="Center" />

                <!-- Master Password -->
                <TextBlock Text="ANA PAROLA" Style="{StaticResource PVLabel}" />
                <PasswordBox x:Name="SetupPasswordBox" Style="{StaticResource PVPasswordBox}"
                             PasswordChanged="SetupPasswordBox_PasswordChanged" />

                <!-- Strength Bar -->
                <Grid Margin="0,8,0,0" Height="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding SetupStrength.ScorePercent, Converter={StaticResource ScoreToWidth}}" />
                        <ColumnDefinition Width="{Binding SetupStrength.ScorePercent, Converter={StaticResource ScoreToRemaining}}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2"
                            Background="{Binding SetupStrength.HexColor, Converter={StaticResource HexToBrush}}" />
                    <Border Grid.Column="1" CornerRadius="2" Background="{DynamicResource BgTertiary}" />
                </Grid>
                <TextBlock Margin="0,4,0,0" FontSize="11"
                           Foreground="{Binding SetupStrength.HexColor, Converter={StaticResource HexToBrush}}">
                    <Run Text="{Binding SetupStrength.Label, Mode=OneWay}" />
                    <Run Text=" &#x2014; " Foreground="{DynamicResource TextMuted}" />
                    <Run Text="{Binding SetupStrength.EntropyBits, StringFormat='{}{0} bit', Mode=OneWay}"
                         Foreground="{DynamicResource TextMuted}" />
                </TextBlock>

                <!-- Confirm Password -->
                <TextBlock Text="PAROLA TEKRAR" Style="{StaticResource PVLabel}" Margin="0,16,0,5" />
                <PasswordBox x:Name="SetupConfirmBox" Style="{StaticResource PVPasswordBox}"
                             PasswordChanged="SetupConfirmBox_PasswordChanged" />

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                <!-- Create button -->
                <Button Content="Sand&#x131;&#x11F;&#x131; Olu&#x15F;tur ve Kilitle" Style="{StaticResource PVButtonPrimary}"
                        Command="{Binding CreateVaultCommand}" Margin="0,22,0,0"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="&#x26A0; Ana parolan&#x131;z&#x131; unutursan&#x131;z sand&#x131;&#x11F;&#x131;n&#x131;za eri&#x15F;im sa&#x11F;lanamaz."
                           Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>