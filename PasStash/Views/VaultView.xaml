<UserControl x:Class="PassVault.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PassVault.Core.Models"
             xmlns:views="clr-namespace:PassVault.Views">

    <Grid Background="{DynamicResource BgPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- â•â•â•â•â•â•â•â•â• LEFT SIDEBAR â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Column="0" Background="{DynamicResource BgSecondary}" Padding="10,14">
            <DockPanel>
                <!-- Top: Logo + Lock -->
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonIcon}"
                            Command="{Binding LockCommand}" ToolTip="Sand&#x131;&#x11F;&#x131; Kilitle"
                            VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextSecondary}" />
                        </Viewbox>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#F59E0B" />
                            </Border.Effect>
                            <Image Source="/PasStash;component/icon.png" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PasStash" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="&#x15E;&#x130;FRE SANDI&#x11E;I" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimary}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Bottom: Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="6,10,6,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextMuted}" />
                        </Viewbox>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                            <Run Text="{Binding TotalItemCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" kay&#x131;t saklan&#x131;yor" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section: KATEGORÄ°LER -->
                        <TextBlock Text="KATEGOR&#x130;LER" Style="{StaticResource PVSidebarSectionHeader}" />

                        <!-- All Items -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding ClearFilterCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeAllBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconKey}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="T&#xFC;m Kay&#x131;tlar" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DockPanel>
                        </Button>

                        <!-- Logins -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static models:VaultCategory.Login}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeLoginBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconKey}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Oturum A&#xE7;ma" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Secure Notes -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static models:VaultCategory.SecureNote}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeNoteBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconNote}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="G&#xFC;venli Not" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Cards -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static models:VaultCategory.Card}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeCardBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCard}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Kredi Kart&#x131;" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Server -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static models:VaultCategory.Server}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeServerBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconServer}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Sunucu" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Favorites -->
                        <Button Style="{StaticResource PVNavButton}"
                                Command="{Binding ToggleFavoriteCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeStarBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconStar}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Favoriler" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="6,12" />

                        <!-- Generator shortcut -->
                        <Button Style="{StaticResource PVNavButton}" Command="{Binding OpenGeneratorCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{StaticResource BadgeGeneratorBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDice}" Fill="White" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Parola &#xDC;retici" Foreground="{DynamicResource TextAccent}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DockPanel>
                        </Button>

                        <!-- Theme Toggle shortcut -->
                        <Button Style="{StaticResource PVNavButton}" Command="{Binding ToggleThemeCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{DynamicResource BgTertiary}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsDarkTheme, Converter={StaticResource ThemeIconConverter}}"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tema De&#x11F;i&#x15F;tir" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Export Backup shortcut -->
                        <Button Style="{StaticResource PVNavButton}" Command="{Binding ExportVaultCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{DynamicResource BgTertiary}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconExport}" Fill="{DynamicResource TextSecondary}" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="D&#x131;&#x15F;a Aktar (Yedekle)" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <!-- Import Backup shortcut -->
                        <Button Style="{StaticResource PVNavButton}" Command="{Binding ImportVaultCommand}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{DynamicResource BgTertiary}" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconImport}" Fill="{DynamicResource TextSecondary}" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="&#x130;&#xE7;e Aktar (Y&#xFC;kle)" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{DynamicResource BorderSubtle}" />

        <!-- â•â•â•â•â•â•â•â•â• MIDDLE PANEL - Item List â•â•â•â•â•â•â•â•â• -->
        <DockPanel Grid.Column="2" Background="{DynamicResource BgDeep}">
            <!-- Top: Search + Add button -->
            <DockPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonPrimary}"
                        Command="{Binding AddItemCommand}" Padding="14,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontWeight="Bold" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ekle" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Search Box -->
                <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="8,0">
                    <DockPanel>
                        <Viewbox Width="13" Height="13" Margin="2,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMuted}" />
                        </Viewbox>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource AccentPrimary}"
                                 VerticalAlignment="Center" Padding="0,7" FontSize="12.5" />
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Item List -->
            <ListBox ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="4,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="6,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Category Visual Badge Avatar -->
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0"
                                    Background="{Binding Category, Converter={StaticResource CatToBrush}}"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#000000" />
                                </Border.Effect>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding Category, Converter={StaticResource CatToIcon}}" Fill="White" />
                                </Viewbox>
                            </Border>

                            <!-- Favorite star -->
                            <Viewbox DockPanel.Dock="Right" Width="14" Height="14" VerticalAlignment="Center"
                                     Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconStar}" Fill="#F59E0B" />
                            </Viewbox>

                            <!-- Title & Subtitle (Smart Subtitle: Note preview for notes, Username for logins) -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Converter={StaticResource VaultItemSubtitle}}" FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Divider -->
        <Border Grid.Column="3" Background="{DynamicResource BorderSubtle}" />

        <!-- â•â•â•â•â•â•â•â•â• RIGHT PANEL - Detail / Edit â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Column="4" Background="{DynamicResource BgPrimary}">
            <!-- Empty state (Treasure Chest Visual) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                <Border Width="88" Height="88" CornerRadius="22" Margin="0,0,0,16" HorizontalAlignment="Center"
                        Background="{DynamicResource BgSecondary}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.3" Color="#F59E0B" />
                    </Border.Effect>
                    <Image Source="/PasStash;component/icon.png" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Text="Parola Sand&#x131;&#x11F;&#x131;" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="Detaylar&#x131; g&#xF6;r&#xFC;nt&#xFC;lemek veya d&#xFC;zenlemek i&#xE7;in listeden bir kay&#x131;t se&#xE7;in"
                           Foreground="{DynamicResource TextMuted}" FontSize="12.5" Margin="0,5,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Detail view -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}"
                          Padding="28,24">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <!-- Header with Title, Category Avatar, and Action Buttons -->
                    <DockPanel Margin="0,0,0,24">
                        <!-- Action buttons -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Favorite Toggle -->
                            <Button Style="{StaticResource PVButtonIcon}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    ToolTip="Favori" Margin="0,0,6,0">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{Binding SelectedItem.IsFavorite, Converter={StaticResource FavToIcon}}"
                                          Fill="#F59E0B" />
                                </Viewbox>
                            </Button>

                            <!-- Edit Button -->
                            <Button Style="{StaticResource PVButtonSecondary}"
                                    Command="{Binding StartEditCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                    Margin="0,0,6,0" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                        <Path Data="{StaticResource IconEdit}" Fill="{DynamicResource TextPrimary}" />
                                    </Viewbox>
                                    <TextBlock Text="D&#xFC;zenle" FontSize="12.5" />
                                </StackPanel>
                            </Button>

                            <!-- Delete Button -->
                            <Button Style="{StaticResource PVButtonDanger}"
                                    Command="{Binding DeleteItemCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    ToolTip="Kayd&#x131; Sil" Padding="10,8">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource IconDelete}" Fill="White" />
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- Category Avatar Badge + Title -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="11" Margin="0,0,14,0"
                                    Background="{Binding SelectedItem.Category, Converter={StaticResource CatToBrush}}"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2" Color="#000000" />
                                </Border.Effect>
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding SelectedItem.Category, Converter={StaticResource CatToIcon}}" Fill="White" />
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.Title}" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedItem.Category, Converter={StaticResource CatToName}, Mode=OneWay}" />
                                    <Run Text=" &#x2022; " />
                                    <Run Text="{Binding SelectedItem.UpdatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- â•â•â•â•â•â•â•â•â• VIEW MODE â•â•â•â•â•â•â•â•â• -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <!-- Username (Hidden for SecureNote) -->
                        <Border Background="{DynamicResource BgSecondary}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Visibility="{Binding SelectedItem.Category, Converter={StaticResource SecureNoteVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonIcon}"
                                        Command="{Binding CopyUsernameCommand}" ToolTip="Kullan&#x131;c&#x131; Ad&#x131;n&#x131; Kopyala">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextSecondary}" />
                                    </Viewbox>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="KULLANICI ADI" Style="{StaticResource PVLabel}" />
                                    <TextBlock Text="{Binding SelectedItem.Username}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Password (Hidden for SecureNote) -->
                        <Border Background="{DynamicResource BgSecondary}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Visibility="{Binding SelectedItem.Category, Converter={StaticResource SecureNoteVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <!-- Reveal toggle -->
                                    <Button Style="{StaticResource PVButtonIcon}"
                                            Command="{Binding TogglePasswordVisibilityCommand}"
                                            ToolTip="Parolay&#x131; G&#xF6;ster / Gizle" Margin="0,0,4,0">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, ConverterParameter='IconEyeOff:IconEye'}"
                                                  Fill="{DynamicResource TextSecondary}" />
                                        </Viewbox>
                                    </Button>
                                    <!-- Copy -->
                                    <Button Style="{StaticResource PVButtonIcon}"
                                            Command="{Binding CopyPasswordCommand}" ToolTip="Parolay&#x131; Kopyala">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextSecondary}" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="PAROLA" Style="{StaticResource PVLabel}" />
                                    <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Consolas">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PwdMask}">
                                                <Binding Path="SelectedItem.Password" />
                                                <Binding Path="IsPasswordVisible" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <!-- Strength Indicator -->
                                    <Grid Margin="0,6,0,0" Height="3" Width="180" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding SelectedItemPasswordStrength.ScorePercent, Converter={StaticResource ScoreToWidth}}" />
                                            <ColumnDefinition Width="{Binding SelectedItemPasswordStrength.ScorePercent, Converter={StaticResource ScoreToRemaining}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2"
                                                Background="{Binding SelectedItemPasswordStrength.HexColor, Converter={StaticResource HexToBrush}}" />
                                        <Border Grid.Column="1" CornerRadius="2" Background="{DynamicResource BgTertiary}" />
                                    </Grid>
                                    <TextBlock FontSize="10" Margin="0,3,0,0"
                                               Foreground="{Binding SelectedItemPasswordStrength.HexColor, Converter={StaticResource HexToBrush}}"
                                               Text="{Binding SelectedItemPasswordStrength.Label, Mode=OneWay}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- URL (Hidden for SecureNote) -->
                        <Border Background="{DynamicResource BgSecondary}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Visibility="{Binding SelectedItem.Category, Converter={StaticResource SecureNoteVis}}">
                            <StackPanel>
                                <TextBlock Text="WEB ADRES&#x130;" Style="{StaticResource PVLabel}" />
                                <TextBlock Text="{Binding SelectedItem.Url}" FontSize="13"
                                           Foreground="{DynamicResource TextAccent}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Notes (Always visible for SecureNote, or when not empty) -->
                        <Border Background="{DynamicResource BgSecondary}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NoteCardVis}}">
                            <StackPanel>
                                <TextBlock Text="G&#xDC;VENL&#x130; NOT / MET&#x130;N" Style="{StaticResource PVLabel}" />
                                <TextBlock Text="{Binding SelectedItem.Notes}" FontSize="14" LineHeight="20"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- â•â•â•â•â•â•â•â•â• EDIT MODE â•â•â•â•â•â•â•â•â• -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <!-- Title -->
                        <TextBlock Text="BA&#x15E;LIK" Style="{StaticResource PVLabel}" />
                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PVTextBox}" Margin="0,0,0,14" />

                        <!-- Category -->
                        <TextBlock Text="KATEGOR&#x130;" Style="{StaticResource PVLabel}" />
                        <ComboBox ItemsSource="{Binding AvailableCategories}"
                                  SelectedItem="{Binding EditCategory}"
                                  Style="{StaticResource PVComboBox}"
                                  Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                            <Path Data="{Binding Converter={StaticResource CatToIcon}}"
                                                  Fill="{DynamicResource AccentPrimary}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding Converter={StaticResource CatToName}}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Username (Hidden if SecureNote) -->
                        <StackPanel Visibility="{Binding EditCategory, Converter={StaticResource SecureNoteVis}}">
                            <TextBlock Text="KULLANICI ADI" Style="{StaticResource PVLabel}" />
                            <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PVTextBox}" Margin="0,0,0,14" />
                        </StackPanel>

                        <!-- Password (Hidden if SecureNote) -->
                        <StackPanel Visibility="{Binding EditCategory, Converter={StaticResource SecureNoteVis}}">
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonSecondary}"
                                        Command="{Binding OpenGeneratorCommand}" ToolTip="Parola &#xDC;ret" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,4,0">
                                            <Path Data="{StaticResource IconDice}" Fill="{DynamicResource TextPrimary}" />
                                        </Viewbox>
                                        <TextBlock Text="&#xDC;ret" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="PAROLA" Style="{StaticResource PVLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PVTextBox}" FontFamily="Consolas" Margin="0,0,0,14" />
                        </StackPanel>

                        <!-- URL (Hidden if SecureNote) -->
                        <StackPanel Visibility="{Binding EditCategory, Converter={StaticResource SecureNoteVis}}">
                            <TextBlock Text="WEB ADRES&#x130;" Style="{StaticResource PVLabel}" />
                            <TextBox Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PVTextBox}" Margin="0,0,0,14" />
                        </StackPanel>

                        <!-- Notes (Expanded height for SecureNote) -->
                        <TextBlock Text="G&#xDC;VENL&#x130; NOT / A&#xC7;IKLAMA" Style="{StaticResource PVLabel}" />
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PVTextBox}"
                                 Height="{Binding EditCategory, Converter={StaticResource NoteBoxHeight}}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" />

                        <!-- Save / Cancel buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Kaydet" Style="{StaticResource PVButtonPrimary}"
                                    Command="{Binding SaveItemCommand}" Margin="0,0,10,0" Padding="24,10" />
                            <Button Content="&#x130;ptal" Style="{StaticResource PVButtonSecondary}"
                                    Command="{Binding CancelEditCommand}" Padding="20,10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â• PASSWORD GENERATOR MODAL OVERLAY â•â•â•â•â•â•â•â•â• -->
        <Grid Grid.Column="0" Grid.ColumnSpan="5"
              Background="#80000000"
              Visibility="{Binding IsGeneratorOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Width="400" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel DataContext="{Binding GeneratorVM}">
                    <!-- Titlebar -->
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonIcon}"
                                Command="{Binding DataContext.CloseGeneratorCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                ToolTip="Kapat">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextSecondary}" />
                            </Viewbox>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentPrimary}">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconDice}" Fill="White" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Parola &#xDC;retici" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Generated password display -->
                    <Border Background="{DynamicResource BgDeep}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PVButtonIcon}"
                                    Command="{Binding GenerateCommand}" ToolTip="Yeniden &#xDC;ret">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource AccentPrimary}" />
                                </Viewbox>
                            </Button>
                            <TextBlock Text="{Binding GeneratedPassword}" FontSize="15" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Length slider -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimary}" Width="24" TextAlignment="Right" />
                        <TextBlock Text="Uzunluk" Style="{StaticResource PVLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="8" Maximum="64" Value="{Binding Length}"
                            Style="{StaticResource PVSlider}" Margin="0,0,0,18" />

                    <!-- Checkboxes -->
                    <CheckBox Content="B&#xFC;y&#xFC;k Harfler (A-Z)" IsChecked="{Binding IncludeUppercase}"
                              Style="{StaticResource PVCheckBox}" Margin="0,0,0,10" />
                    <CheckBox Content="K&#xFC;&#xE7;&#xFC;k Harfler (a-z)" IsChecked="{Binding IncludeLowercase}"
                              Style="{StaticResource PVCheckBox}" Margin="0,0,0,10" />
                    <CheckBox Content="Rakamlar (0-9)" IsChecked="{Binding IncludeDigits}"
                              Style="{StaticResource PVCheckBox}" Margin="0,0,0,10" />
                    <CheckBox Content="Semboller (!@#$%)" IsChecked="{Binding IncludeSpecial}"
                              Style="{StaticResource PVCheckBox}" Margin="0,0,0,10" />
                    <CheckBox Content="Benzer Karakterleri Hari&#xE7; Tut (il1Lo0O)"
                              IsChecked="{Binding ExcludeAmbiguous}" Style="{StaticResource PVCheckBox}" />

                    <!-- Action buttons -->
                    <Button Content="Bu Parolay&#x131; Kullan" Style="{StaticResource PVButtonPrimary}"
                            Command="{Binding DataContext.UseGeneratedPasswordCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Margin="0,18,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>